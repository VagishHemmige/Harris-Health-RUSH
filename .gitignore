# R, RStudio and Positron
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.httr-oauth
.DS_Store

# Quarto. docs/ is the local render; GitHub Actions renders the site and
# publishes it to the gh-pages branch (.github/workflows/publish.yml)
/docs/
/.quarto/
**/*.quarto_ipynb
/_freeze/

# Credentials
.Renviron
.env
*.pem
*.key

# Data files. The de-identified RUSH workbooks live outside the repository,
# in the folder named by RUSH_DATA_DIR; this is a safety net, not access
# control.
/data-raw/
/data/
*.csv
*.xlsx
*.xls
*.rds
*.rda
*.dta
*.sav
*.parquet

# Stata logs and results files hold output from the study data. The
# original .do file (stata/) is code and is tracked; its 2015 log is not.
*.log
*.smcl
*.ster

# Outputs from the study data: R/tables.R writes Tables 1 to 4 to tables/.
# The tables on the site are built from the article's printed values
# (quarto/published/), not from these.
/figures/
/tables/

# Approved files: add narrow exceptions here, never a whole format.
# The values printed in the article's Tables 1 to 4, typed in from the
# article (public), which the website formats for display.
!/quarto/published/table_1.csv
!/quarto/published/tables_2_to_4.csv
